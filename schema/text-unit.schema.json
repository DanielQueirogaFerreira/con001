{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://con001.dev/schema/text-unit.schema.json",
  "title": "TextUnit",
  "description": "One addressable unit (typically a verse) of one Edition. The characters live here, and span offsets are measured into `text`.",
  "type": "object",
  "required": ["type", "edition", "cr", "text"],
  "additionalProperties": false,
  "properties": {
    "type": { "const": "TextUnit" },
    "edition": { "type": "string", "pattern": "^ed:" },
    "cr": { "type": "string" },
    "text": { "type": "string", "minLength": 1 },
    "label": { "type": "string", "description": "Display label, e.g. '2.47'." }
  }
}
