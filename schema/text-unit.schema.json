{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://con001.dev/schema/text-unit.schema.json",
  "title": "TextUnit",
  "description": "One addressable unit (typically a verse) of one Edition. The characters live here, and span offsets are measured into `text`.",
  "type": "object",
  "required": [
    "type",
    "edition",
    "cr",
    "text",
    "provenance"
  ],
  "additionalProperties": false,
  "properties": {
    "type": {
      "const": "TextUnit"
    },
    "edition": {
      "type": "string",
      "pattern": "^ed:"
    },
    "cr": {
      "type": "string"
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "label": {
      "type": "string",
      "description": "Display label, e.g. '2.47'."
    },
    "provenance": {
      "type": "object",
      "description": "Where this text came from and whether it has been checked. Sacred source text is ingested from an authoritative digital edition and checksummed, never hand-entered. An unverified unit never reaches a reader.",
      "required": [
        "source",
        "verified",
        "sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "verified": {
          "type": "boolean"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "verified_by": {
          "type": "string"
        },
        "verified_on": {
          "type": "string"
        }
      }
    }
  }
}
