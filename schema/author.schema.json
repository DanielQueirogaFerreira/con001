{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://con001.dev/schema/author.schema.json",
  "title": "Author",
  "description": "Every interpretation carries its author. There is no anonymous voice and no house voice.",
  "type": "object",
  "required": ["type", "display"],
  "additionalProperties": false,
  "properties": {
    "type": { "enum": ["historical", "institution", "user", "model"] },
    "id": { "type": "string" },
    "display": { "type": "string", "minLength": 1 },
    "school": { "type": "string" },
    "century": { "type": "integer" },
    "model": { "type": "string", "description": "Required when type is 'model'." },
    "generated": { "type": "string", "description": "ISO date. Required when type is 'model'." },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "description": "What the model was given. A machine reading produced after reading Sankara is a different object from one produced cold, and the reader is entitled to know which one they have.",
      "properties": {
        "layers_in_context": { "type": "array", "items": { "type": "string" } },
        "editions_in_context": { "type": "array", "items": { "type": "string" } },
        "prompt": { "type": "string" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "model" } }, "required": ["type"] },
      "then": { "required": ["model", "generated", "inputs"] }
    }
  ]
}
